{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image Reverse Engineering v3 report",
  "type": "object",
  "required": [
    "file",
    "dimensions",
    "aspect_ratio",
    "technical_metrics",
    "dominant_palette_estimate",
    "semantic_analysis"
  ],
  "properties": {
    "file": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "dimensions": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        }
      }
    },
    "aspect_ratio": {
      "type": "number"
    },
    "orientation": {
      "enum": [
        "landscape",
        "portrait",
        "square"
      ]
    },
    "technical_metrics": {
      "type": "object"
    },
    "dominant_palette_estimate": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hex",
          "share_estimate"
        ],
        "properties": {
          "hex": {
            "type": "string"
          },
          "share_estimate": {
            "type": "number"
          }
        }
      }
    },
    "semantic_analysis": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
